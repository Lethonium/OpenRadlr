{
  "name": "openradlr-app",
  "version": "0.1.0",
  "private": true,
  "description": "OpenRadlr for iOS and Android: the browser client in a native shell with Bluetooth (Capacitor).",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sync": "cap sync",
    "ios": "cap sync ios && cap open ios",
    "android": "cap sync android && cap open android",
    "android:bundle": "node scripts/bundle-android.mjs",
    "assets": "node scripts/make-assets.mjs && npx --yes @capacitor/assets@3.0.5 generate --ios --android --iconBackgroundColor \"#080a0e\" --iconBackgroundColorDark \"#080a0e\" --splashBackgroundColor \"#080a0e\" --splashBackgroundColorDark \"#080a0e\""
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.3.0",
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/share": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "minimatch": "^11.0.1",
    "uuid": "^11.1.1"
  }
}
