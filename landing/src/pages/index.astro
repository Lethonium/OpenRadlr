---
import { Picture } from "astro:assets";
import Base from "../layouts/Base.astro";
import Profile from "../components/Profile.astro";
import { site, appHost } from "../site";
import hero from "../assets/hero.png";
import ride from "../assets/ride.png";
import studio from "../assets/studio.png";

const devicesUrl = `${site.githubUrl}/blob/main/docs/devices.md`;

const features = [
  {
    title: "One island, everyone on it",
    text: "Pick a route and you ride the same roads as everyone else on the server: valley, cliffs, a col and three cafés.",
  },
  {
    title: "Never an empty road",
    text: "Bots ride along when it’s quiet, each with its own fitness and style. They’re always marked, and make room as people join.",
  },
  {
    title: "Drafting and races",
    text: "Sit on a wheel to save watts. Join a race during its countdown, then go for the climbs and the sprints.",
  },
  {
    title: "Spin studio",
    text: "A group class starts every 30 minutes. Coach Lemon calls the blocks, targets follow your FTP, and the room board ranks time on target.",
  },
  {
    title: "Workouts in ERG mode",
    text: "Ride the built-in sessions or import your own .zwo files. The trainer holds the watts, you hold on.",
  },
  {
    title: "Virtual shifting",
    text: "Gears for single-speed setups like the Zwift Cog. Shift from the keyboard, the screen or a Zwift Click, Play or Ride.",
  },
  {
    title: "Strava upload",
    text: "Finish a ride and send it to Strava as a virtual ride with its climbing and a map. Or download .fit, .gpx and .tcx.",
  },
  {
    title: "Browser and Android",
    text: "Use Chrome or Edge, or get the Android app with native Bluetooth for your trainer.",
  },
];

const faq = [
  {
    q: "Is it really free?",
    a: "Yes. Riding is free, with no subscription and no paywalled features. The code is open source, so anyone can run their own server too.",
  },
  {
    q: "Do I need an account?",
    a: "No. Enter a name and ride. Your profile (weight, FTP, devices) stays in your browser. Connecting Strava is optional and only needed for uploads.",
  },
  {
    q: "Is there an Android app?",
    a: "Yes. The free Android app connects to your trainer through native Bluetooth.",
    href: site.googlePlayUrl,
    link: "Get the Android app",
  },
  {
    q: "Does it work on an iPhone or iPad?",
    a: "Safari on iOS can’t talk to Bluetooth devices. The free Bluefy browser can: open the app there. Chrome or Edge on Android, Windows, macOS and ChromeOS work out of the box.",
  },
  {
    q: "I don’t have a smart trainer. Can I still try it?",
    a: "Yes. Pick Simulated trainer on the start screen and set your power with the arrow keys. A power meter on a classic trainer works too, without resistance control.",
  },
  {
    q: "Who are the other riders?",
    a: "People, and bots marked as bots. Bots keep the roads busy when few people are online, chase drafts and race, and leave as more humans join.",
  },
];
---

<Base overlay>
  <section class="hero" aria-labelledby="hero-title">
    <Picture
      class="hero-shot"
      src={hero}
      formats={["avif", "webp"]}
      fallbackFormat="jpg"
      widths={[800, 1280, 1920]}
      sizes="100vw"
      alt="A rider in the OpenRadlr 3D world on a winding country road in evening light, seen from the drone camera."
      loading="eager"
      fetchpriority="high"
    />
    <div class="wrap hero-text">
      <h1 id="hero-title">Free indoor cycling, together.</h1>
      <p class="lede">
        Connect your smart trainer and ride an island world with friends, strangers and bots.
        In your browser or with the Android app.
        Open source, no subscription.
      </p>
      <div class="actions">
        <a class="button primary large" href={site.appUrl}>Ride in your browser</a>
        <a class="google-play" href={site.googlePlayUrl} aria-label="Get OpenRadlr for Android on Google Play"><img src="/brands/google-play.svg" alt="Get it on Google Play" width="216" height="64" /></a>
      </div>
    </div>
    <div class="hero-ground">
      <Profile route="col-de-la-forge" />
    </div>
  </section>

  <section class="section features" aria-labelledby="features-title">
    <div class="wrap split">
      <div class="split-head">
        <h2 id="features-title">Everything you need for a winter on the trainer</h2>
      </div>
      <ul class="feature-list">
        {
          features.map((f) => (
            <li>
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section shots" aria-label="Screenshots">
    <div class="wrap shots-grid">
      <figure>
        <Picture
          src={ride}
          formats={["avif", "webp"]}
          fallbackFormat="jpg"
          widths={[640, 1080, 1600]}
          sizes="(min-width: 68rem) 34rem, 100vw"
          alt="A ride in OpenRadlr: the rider on a country road, with power, speed, cadence and gradient on screen."
        />
        <figcaption>On the road: watts, speed, gradient, and the next sprint or climb.</figcaption>
      </figure>
      <figure>
        <Picture
          src={studio}
          formats={["avif", "webp"]}
          fallbackFormat="jpg"
          widths={[640, 1080, 1600]}
          sizes="(min-width: 68rem) 34rem, 100vw"
          alt="The OpenRadlr spin studio: Coach Lemon on stage, riders side by side, the room board and the class plan with target and power."
        />
        <figcaption>In the spin studio: a class every half hour, bikes side by side.</figcaption>
      </figure>
    </div>
  </section>

  <section class="section needs" aria-labelledby="needs-title">
    <div class="wrap split">
      <div class="split-head">
        <h2 id="needs-title">What you need</h2>
        <p class="muted">About two minutes from opening the page to your first pedal stroke.</p>
      </div>
      <ol class="steps">
        <li>
          <h3>A smart trainer or a power meter</h3>
          <p>
            Anything that speaks Bluetooth FTMS or Cycling Power, like a Wahoo KICKR Core or a Van Rysel D500. A heart
            rate strap is optional. <a href={devicesUrl}>Which devices work</a>
          </p>
        </li>
        <li>
          <h3>The Android app, Chrome or Edge</h3>
          <p>
            On Android, <a href={site.googlePlayUrl}>get OpenRadlr on Google Play</a> for native Bluetooth.
            In a browser, use Chrome or Edge on Windows, macOS, Android or ChromeOS.
            On iPhone and iPad, use the Bluefy browser.
          </p>
        </li>
        <li>
          <h3>A name</h3>
          <p>
            Open <a href={site.appUrl}>{appHost}</a>, type a name, connect your trainer and pick a route. No sign-up.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <section class="section host" id="host" aria-labelledby="host-title">
    <div class="wrap split">
      <div class="split-head">
        <h2 id="host-title">Open source. Host your own.</h2>
      </div>
      <div class="host-body">
        <p>
          OpenRadlr is open source and every server is a single Docker container. Run one at home for your LAN, on a
          small VPS for your club, or ride on ours. The game server is written in Rust, the client is plain JavaScript.
        </p>
        <pre><code><span class="muted"># needs Docker with Compose and make</span>
git clone {site.githubUrl}.git
cd OpenRadlr
make up</code></pre>
        <p>
          Then open <code>http://localhost:8080</code>. Bug reports, routes and pull requests are welcome
          on <a href={site.githubUrl}>GitHub</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="section faq" aria-labelledby="faq-title">
    <div class="wrap split">
      <div class="split-head">
        <h2 id="faq-title">Questions</h2>
      </div>
      <div class="faq-list">
        {
          faq.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <p>{item.a}{"href" in item && <> <a href={item.href}>{item.link}</a>.</>}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section last-call" aria-labelledby="last-call-title">
    <div class="wrap">
      <h2 id="last-call-title">The road is open.</h2>
      <div class="launch-links">
        <a class="launch-link browser-launch" href={site.appUrl}>
          <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="26" height="22" rx="4" /><path d="M3 12h26M8 9h1m3 0h1m1 8 6 3-6 3z" /></svg>
          Ride now
        </a>
        <a class="google-play" href={site.googlePlayUrl} aria-label="Get OpenRadlr for Android on Google Play">
          <img src="/brands/google-play.svg" alt="Get it on Google Play" width="216" height="64" loading="lazy" />
        </a>
        <a class="launch-link discord-launch" href={site.discordUrl || `${site.githubUrl}/issues`}>
          {site.discordUrl ? (<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M19.7 5.1a18.4 18.4 0 0 0-4.5-1.4l-.6 1.2a16.8 16.8 0 0 0-5.2 0l-.6-1.2a18.4 18.4 0 0 0-4.5 1.4C1.5 9.2.7 13.2 1.1 17.2a18 18 0 0 0 5.5 2.8l1.1-1.8-1.7-.8.4-.3a13 13 0 0 0 11.2 0l.4.3-1.7.8 1.1 1.8a18 18 0 0 0 5.5-2.8c.5-4.6-.8-8.5-3.2-12.1ZM8.5 14.9c-1 0-1.8-.9-1.8-2s.8-2 1.8-2 1.8.9 1.8 2-.8 2-1.8 2Zm7 0c-1 0-1.8-.9-1.8-2s.8-2 1.8-2 1.8.9 1.8 2-.8 2-1.8 2Z" /></svg>) : (<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M27 15a11 11 0 0 1-16 10l-7 3 2-8a11 11 0 1 1 21-5Z" /><path d="M11 14h10m-10 5h6" /></svg>)}
          {site.discordUrl ? "Join Discord" : "Give feedback"}
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero: the game's own picture, standing on a real route profile. */
  .hero {
    position: relative;
    min-height: min(100svh, 62rem);
    display: grid;
    grid-template-rows: 1fr auto;
    isolation: isolate;
    overflow: hidden;
  }
  .hero :global(.hero-shot) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 40%;
    z-index: -2;
  }
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to right, rgb(15 18 22 / 0.85) 0%, rgb(15 18 22 / 0.35) 55%, rgb(15 18 22 / 0) 80%),
      linear-gradient(to bottom, rgb(15 18 22 / 0.6) 0%, rgb(15 18 22 / 0) 25%);
  }
  .hero-text {
    align-self: end;
    padding-top: 8rem;
    padding-bottom: clamp(1.5rem, 4vw, 3rem);
  }
  h1 {
    font-size: clamp(3.5rem, 11vw, 8.5rem);
    line-height: 0.88;
    max-width: 11ch;
    text-shadow: 0 2px 24px rgb(15 18 22 / 0.5);
  }
  .lede {
    margin-top: 1.5rem;
    font-size: clamp(1.125rem, 2vw, 1.3rem);
    max-width: 40ch;
    text-shadow: 0 1px 12px rgb(15 18 22 / 0.8);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .actions .button:not(.primary) {
    background: rgb(23 27 33 / 0.75);
    backdrop-filter: blur(6px);
  }
  .hero-ground {
    margin-bottom: -1px;
  }
  .hero-ground :global(figcaption) {
    padding-top: 0.25rem;
    background: var(--bg);
  }

  /* Sections */
  .section {
    padding-block: clamp(4rem, 10vw, 7.5rem);
  }
  .section + .section {
    border-top: 1px solid var(--border);
  }
  .split {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 2.5rem clamp(2rem, 6vw, 5rem);
    align-items: start;
  }
  .split-head {
    position: sticky;
    top: 2rem;
  }
  .split-head p {
    margin-top: 1rem;
  }
  @media (max-width: 52rem) {
    .split {
      grid-template-columns: 1fr;
    }
    .split-head {
      position: static;
    }
  }

  .feature-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 2.25rem 2.5rem;
  }
  .feature-list h3 {
    margin-bottom: 0.4rem;
  }
  .feature-list p {
    color: var(--muted);
  }

  .shots {
    padding-top: 0;
    border-top: 0 !important;
  }
  .shots-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
    gap: 1.5rem;
  }
  .shots figure {
    margin: 0;
  }
  .shots :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }
  .shots figcaption {
    margin-top: 0.75rem;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .steps {
    list-style: none;
    counter-reset: step;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2rem;
  }
  .steps li {
    counter-increment: step;
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    column-gap: 1rem;
  }
  .steps li::before {
    content: counter(step);
    grid-row: span 2;
    font-family: var(--display);
    font-style: italic;
    font-weight: 800;
    font-size: 3.5rem;
    line-height: 0.8;
    color: var(--lemon);
  }
  .steps h3 {
    margin-bottom: 0.4rem;
  }
  .steps p {
    color: var(--muted);
  }

  .host-body {
    display: grid;
    gap: 1.25rem;
  }
  pre {
    margin: 0;
    padding: 1.25rem 1.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow-x: auto;
    line-height: 1.7;
  }

  .faq-list {
    border-top: 1px solid var(--border);
  }
  details {
    border-bottom: 1px solid var(--border);
  }
  summary {
    cursor: pointer;
    padding: 1.1rem 2rem 1.1rem 0;
    font-weight: 600;
    font-size: 1.125rem;
    list-style: none;
    position: relative;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: "+";
    position: absolute;
    right: 0.25rem;
    color: var(--accent);
    font-size: 1.5rem;
    line-height: 1;
    top: 50%;
    translate: 0 -50%;
  }
  details[open] summary::after {
    content: "−";
  }
  details p {
    padding-bottom: 1.25rem;
    color: var(--muted);
  }

  .last-call {
    padding-block: clamp(3rem, 7vw, 5rem);
    text-align: center;
  }
  .last-call h2 {
    font-size: clamp(3rem, 6vw, 4.5rem);
    margin-bottom: 1.5rem;
  }
  .launch-links {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: .75rem;
  }
  .launch-link {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: .75rem;
    min-width: 216px;
    min-height: 64px;
    padding: .8rem 1.5rem;
    border: 1px solid transparent;
    border-radius: 12px;
    font-size: 1.25rem;
    font-weight: 700;
    text-decoration: none;
  }
  .launch-link svg {
    width: 32px;
    height: 32px;
    flex: none;
  }
  .browser-launch {
    background: var(--accent);
    color: var(--accent-text);
  }
  .browser-launch:hover {
    background: #ff8c3a;
    color: var(--accent-text);
  }
  .discord-launch {
    background: #5865f2;
    color: #fff;
  }
  .discord-launch:hover {
    background: #4752c4;
    color: #fff;
  }
  .google-play {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    border-radius: 12px;
  }
  .google-play img {
    display: block;
    width: 216px;
    height: 64px;
  }
  .google-play:hover {
    background: var(--surface);
  }
  @media (max-width: 48rem) {
    .launch-links {
      flex-direction: column;
      gap: 24px;
    }
    .launch-link,
    .launch-links .google-play {
      width: min(100% - 8px, 280px);
      height: auto;
      min-height: 0;
      aspect-ratio: 238.96 / 70.87;
    }
    .launch-links .google-play {
      padding: 0;
      border-radius: 8px;
    }
    .launch-links .google-play img {
      width: 100%;
      height: auto;
    }
  }
</style>
