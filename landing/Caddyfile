# Serves the built landing page inside its container. TLS and the public
# domain are handled by the Caddy in front of it (deploy/Caddyfile).
{
	admin off
	auto_https off
}

:80 {
	root * /srv
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
	# Hashed file names: safe to cache for good.
	header /_astro/* Cache-Control "public, max-age=31536000, immutable"

	file_server

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
