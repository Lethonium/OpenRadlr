# OpenRadlr configuration. Copy to .env (`make setup` does this) and adjust.
# Every value is optional; the defaults below are used when a line is missing.
# After an update, `make setup` (also run by `make up` and `make update`) adds
# settings that are new here to the end of your .env and leaves the rest alone.

# --- Server ------------------------------------------------------------------

# Name shown to riders.
OPENRADLR_SERVER_NAME=OpenRadlr

# Default route (file in ./routes without .json). Every other route in ./routes
# is offered on the start screen too, each as its own world.
OPENRADLR_ROUTE=rolling-hills

# Humans + bots the server keeps riding. Bots fill up and leave as humans join.
OPENRADLR_TARGET_RIDERS=12

# Maximum number of human riders at the same time, across all routes.
OPENRADLR_MAX_PLAYERS=50

# Extra seats for riders on phone paddles. They never take a trainer rider's seat.
OPENRADLR_MAX_PADDLE_PLAYERS=20

# Most riders in one state message. Humans come first, the nearest bots fill the rest.
OPENRADLR_MAX_VISIBLE_RIDERS=200

# Simulation and broadcast rate in Hz.
OPENRADLR_TICK_HZ=20
OPENRADLR_BROADCAST_HZ=4

# Race settings. Races are opt-in: riders join during the countdown.
OPENRADLR_RACE_COUNTDOWN_S=30
OPENRADLR_MAX_RACE_LAPS=20

# Fixed seed for reproducible bots (names, fitness, positions). Empty = random.
OPENRADLR_BOT_SEED=

# Only "open" is supported in the proof of concept (local profiles).
OPENRADLR_AUTH_MODE=open

# Log level: error, warn, info, debug, trace (RUST_LOG syntax).
RUST_LOG=info

# --- Network -----------------------------------------------------------------

# Host interface and port for the web client and WebSocket.
# 127.0.0.1 = this machine only. 0.0.0.0 = reachable from the network.
OPENRADLR_HTTP_BIND=127.0.0.1
OPENRADLR_HTTP_PORT=8080

# The address riders open, e.g. https://ride.example.org. Needed for Strava;
# also restricts WebSocket connections to pages from this address.
OPENRADLR_PUBLIC_URL=

# Behind a reverse proxy (Caddy, nginx, Traefik): take client IPs from
# X-Forwarded-For. Only enable it when the proxy is the only way in.
OPENRADLR_TRUST_PROXY=false

# --- Protection --------------------------------------------------------------
# Simultaneous WebSocket connections per client IP (a family on one router
# needs one per rider).
OPENRADLR_MAX_CONNECTIONS_PER_IP=4
# Sustained messages per second per connection (the client sends about 4).
OPENRADLR_MESSAGES_PER_SECOND=20

# --- Strava (optional) -------------------------------------------------------
# Create an API application at https://www.strava.com/settings/api and set its
# "Authorization Callback Domain" to the host of OPENRADLR_PUBLIC_URL.
OPENRADLR_STRAVA_CLIENT_ID=
OPENRADLR_STRAVA_CLIENT_SECRET=
# Keeps riders connected to Strava across restarts and updates: their logins are
# saved in the `data` volume with the refresh tokens encrypted by this key.
# Any random string of 16+ characters, e.g. `openssl rand -hex 32`. Keep it the
# same across deploys; changing it just logs everyone out of Strava once.
# Without it, logins are lost on every restart.
OPENRADLR_SECRET_KEY=
# true: riders must connect Strava before they can join (one ride per
# account at a time) — a simple hurdle for bots and scripts.
OPENRADLR_REQUIRE_STRAVA=false

# --- Start screen ------------------------------------------------------------
# Offer the simulated trainer (keyboard power). Handy for testing; set to
# false in production so only real trainers ride.
OPENRADLR_ALLOW_SIMULATED_TRAINER=true

# Offer phone paddles: ride without a trainer by tapping left and right on a
# phone. Paddle riders race with everyone, get a 📱 next to their name and
# can't upload to Strava.
OPENRADLR_ALLOW_PADDLE_MODE=true

# --- Privacy policy (optional) ----------------------------------------------
# Link to your privacy policy, shown in the start menu and — when the landing
# page is enabled — its footer. A public server should have one (GDPR).
# Empty = no link.
OPENRADLR_PRIVACY_URL=

# --- Analytics (optional, off by default) ------------------------------------
# Cookie-free Plausible page analytics for the browser client. Nothing is loaded
# and nothing leaves the rider's browser unless you set a domain.
# OPENRADLR_ANALYTICS_DOMAIN is the site name in your Plausible account;
# OPENRADLR_ANALYTICS_SCRIPT defaults to Plausible Cloud (https://plausible.io/js/script.js),
# set it to your own instance's script URL when you self-host Plausible (https only).
OPENRADLR_ANALYTICS_DOMAIN=
OPENRADLR_ANALYTICS_SCRIPT=

# --- Spin studio -------------------------------------------------------------
# Stationary group classes next to the routes: a class every 30 minutes,
# rooms of 16 filled up with bots (OPENRADLR_TARGET_RIDERS per room).
OPENRADLR_STUDIO=true

# --- Scheduled events --------------------------------------------------------
# default = built-in timetable (group ride hourly, race every 2 h), off = none,
# or the path of a JSON events file (see docs/events.md).
#OPENRADLR_EVENTS=default
# Seconds the lobby opens before the start. Above ~900 the built-in events
# overlap and the server refuses to start.
#OPENRADLR_EVENT_LOBBY_S=600

# --- HTTPS (bundled Caddy, optional) -----------------------------------------
# Not needed when your own reverse proxy terminates TLS (see docs/deploy.md).
# Web Bluetooth only works on https:// or http://localhost. For a public
# server, point a DNS record at it, then enable Caddy:
#
#   COMPOSE_PROFILES=tls
#   OPENRADLR_DOMAIN=ride.example.org
#
# Caddy obtains a Let's Encrypt certificate automatically (ports 80 and 443).
COMPOSE_PROFILES=
OPENRADLR_DOMAIN=

# --- Landing page (optional) -------------------------------------------------
# A static page that explains OpenRadlr, with the app on a subdomain, e.g.
# openradlr.com (landing) and app.openradlr.com (app). Add "landing" to
# COMPOSE_PROFILES (COMPOSE_PROFILES=tls,landing), set OPENRADLR_DOMAIN and
# OPENRADLR_PUBLIC_URL to the app's subdomain, and set:
#
#   OPENRADLR_LANDING_DOMAIN=openradlr.com, www.openradlr.com
#   OPENRADLR_LANDING_URL=https://openradlr.com
#
# www. redirects to the bare domain. Without your own domain, leave it all empty.
OPENRADLR_LANDING_DOMAIN=
OPENRADLR_LANDING_URL=
# Port for your own reverse proxy (the bundled Caddy doesn't need it).
OPENRADLR_LANDING_PORT=8081
# Optional links and cookie-free Plausible analytics (empty = no script).
OPENRADLR_DISCORD_URL=
# Your imprint (legal notice), linked in the landing page footer. E.g. a page
# generated with https://www.online-impressum.de — required in Germany.
# Empty = no link, so every self-hoster provides their own imprint.
OPENRADLR_LANDING_IMPRINT_URL=
# The script is OPENRADLR_ANALYTICS_SCRIPT above (Plausible Cloud when empty).
OPENRADLR_LANDING_PLAUSIBLE_DOMAIN=

# --- Build -------------------------------------------------------------------
OPENRADLR_IMAGE_TAG=local
